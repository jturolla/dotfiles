# Local LLM service ports (deterministic — see make llm)
LLM_OLLAMA_HOST=127.0.0.1
LLM_OLLAMA_PORT=11434
LLM_OPENAI_PORT=11434
LLM_PORT_OPEN_WEBUI=8080
LLM_PORT_LMSTUDIO=1234

export OLLAMA_HOST="${LLM_OLLAMA_HOST}:${LLM_OLLAMA_PORT}"
export LLM_API_BASE="http://${OLLAMA_HOST}"
export LLM_OPENAI_BASE="http://${OLLAMA_HOST}/v1"

# Canonical entrypoint for OpenAI-compatible clients (Cursor, Continue, LiteLLM, …)
export OPENAI_API_BASE="${LLM_OPENAI_BASE}"
export OPENAI_BASE_URL="${LLM_OPENAI_BASE}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
