#!/usr/bin/env bash
#
# Canonical local LLM entrypoint.
#
# One server (LLM_OPENAI_BASE), many models — pick per request via -m or fzf.
# Same pattern as OpenAI, vLLM, TGI, and Ollama's /v1 API.
#
# Usage:
#   llm                          Status + installed models
#   llm list                     List local models
#   llm chat [model]             Interactive chat (ollama REPL)
#   llm ask "prompt" [-m model]  One-shot via OpenAI-compatible API
#   llm pick                     fzf choose default model (writes config)
#   llm api                      Print base URL for IDEs / Cursor / Continue

set -euo pipefail

DOTFILES_LLM_ENV="${DOTFILES:-$HOME/dev/dotfiles}/config/llm.env"
USER_LLM_ENV="${HOME}/.config/dotfiles/llm.env"
LLM_MODELS_FILE="${HOME}/.config/dotfiles/llm.models"
LLM_DEFAULT_FILE="${HOME}/.config/dotfiles/llm.default"

llm_load_env() {
    [[ -f "$DOTFILES_LLM_ENV" ]] && source "$DOTFILES_LLM_ENV"
    [[ -f "$USER_LLM_ENV" ]] && source "$USER_LLM_ENV"

    : "${LLM_OPENAI_BASE:=http://127.0.0.1:11434/v1}"
    : "${LLM_API_BASE:=http://127.0.0.1:11434}"
    export LLM_OPENAI_BASE LLM_API_BASE OLLAMA_HOST
    export OPENAI_API_BASE="${OPENAI_API_BASE:-$LLM_OPENAI_BASE}"
    export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LLM_OPENAI_BASE}"
}

llm_default_model() {
    if [[ -f "$LLM_DEFAULT_FILE" ]]; then
        tr -d '[:space:]' < "$LLM_DEFAULT_FILE"
        return
    fi
    if [[ -f "$LLM_MODELS_FILE" ]]; then
        head -n1 "$LLM_MODELS_FILE"
        return
    fi
    echo "${LLM_DEFAULT_MODEL:-}"
}

llm_installed_models() {
    {
        if command -v ollama >/dev/null 2>&1; then
            ollama list 2>/dev/null | awk 'NR>1 {print $1}' || true
        fi
        if [[ -f "$LLM_MODELS_FILE" ]]; then
            cat "$LLM_MODELS_FILE"
        fi
    } | awk 'NF && !seen[$0]++'
}

llm_pick_model() {
    local given="${1:-}"
    [[ -n "$given" ]] && { echo "$given"; return; }

    local default
    default="$(llm_default_model)"

    if ! command -v fzf >/dev/null 2>&1; then
        [[ -n "$default" ]] && { echo "$default"; return; }
        echo "No model specified and fzf not available. Use: llm ask -m <model> \"...\"" >&2
        return 1
    fi

    local models header
    models="$(llm_installed_models)"
    [[ -n "$models" ]] || {
        echo "No models installed. Run: make llm" >&2
        return 1
    }

    header="Pick model · API: ${LLM_OPENAI_BASE} · Enter to confirm"
    printf '%s\n' "$models" | fzf --height=40% --header="$header" --query="${default:-}"
}

llm_cmd_list() {
    echo "API:    ${LLM_OPENAI_BASE}"
    echo "Models:"
    llm_installed_models | sed 's/^/  /'
}

llm_cmd_status() {
    llm_load_env
    echo "Canonical entrypoint: llm"
    echo "  OpenAI API:  ${LLM_OPENAI_BASE}"
    echo "  Native API:  ${LLM_API_BASE}"
    echo "  Default:     $(llm_default_model || echo '(none — run: llm pick)')"
    echo ""
    if curl -sf "${LLM_API_BASE}/api/tags" >/dev/null 2>&1; then
        echo "  Server:      running"
        llm_cmd_list
    else
        echo "  Server:      not reachable (start with: brew services start ollama)"
    fi
}

llm_cmd_chat() {
    local model="${1:-}"
    llm_load_env
    model="$(llm_pick_model "$model")"
    command -v ollama >/dev/null 2>&1 || {
        echo "ollama CLI not found" >&2
        return 1
    }
    exec ollama run "$model"
}

llm_cmd_ask() {
    local model="" prompt=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            -m|--model) model="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: llm ask [-m model] \"your prompt\""
                exit 0
                ;;
            *)
                if [[ -z "$prompt" ]]; then
                    prompt="$1"
                else
                    prompt="$prompt $1"
                fi
                shift
                ;;
        esac
    done

    [[ -n "$prompt" ]] || {
        echo "Usage: llm ask [-m model] \"your prompt\"" >&2
        return 1
    }

    llm_load_env
    command -v jq >/dev/null 2>&1 || {
        echo "jq is required for llm ask" >&2
        return 1
    }

    model="$(llm_pick_model "$model")"

    curl -sf "${LLM_OPENAI_BASE}/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
            --arg model "$model" \
            --arg content "$prompt" \
            '{model: $model, messages: [{role: "user", content: $content}], stream: false}')" \
    | jq -r '.choices[0].message.content // .error.message // .'
}

llm_cmd_pick() {
    llm_load_env
    local model
    model="$(llm_pick_model "")" || return 1
    mkdir -p "$(dirname "$LLM_DEFAULT_FILE")"
    printf '%s\n' "$model" > "$LLM_DEFAULT_FILE"
    echo "Default model: $model"
    echo "All requests via ${LLM_OPENAI_BASE} with model=$model (override with -m)"
}

llm_cmd_api() {
    llm_load_env
    cat <<EOF
# Point any OpenAI-compatible client here (Cursor, Continue, aiohttp, etc.)
OPENAI_API_BASE=${LLM_OPENAI_BASE}
OPENAI_BASE_URL=${LLM_OPENAI_BASE}
OPENAI_API_KEY=ollama
LLM_OPENAI_BASE=${LLM_OPENAI_BASE}

# Per-request model name (Ollama tag), e.g. qwen2.5:14b
# Default: $(llm_default_model || echo '<run llm pick>')
EOF
}

llm_usage() {
    cat <<'EOF'
llm — canonical local LLM entrypoint (one API URL, model per request)

  llm                    Status and installed models
  llm list               List models
  llm chat [model]       Interactive chat (fzf if model omitted)
  llm ask "..." [-m M]   One-shot prompt via OpenAI-compatible API
  llm pick               Set default model (fzf)
  llm api                Env vars for IDEs and scripts

Install models: make llm / make llm-select
EOF
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        ""|status)  llm_cmd_status ;;
        list|models|ls) llm_load_env; llm_cmd_list ;;
        chat)       llm_cmd_chat "$@" ;;
        ask)        llm_cmd_ask "$@" ;;
        pick|use)   llm_cmd_pick ;;
        api|env)    llm_cmd_api ;;
        -h|--help|help) llm_usage ;;
        *)
            echo "Unknown command: $cmd" >&2
            llm_usage >&2
            return 1
            ;;
    esac
}

main "$@"
